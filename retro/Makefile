# EasyAmp retro - Windows 98 SE / XP client.
#   make shots   render every UI state to build/shots/*.png on this machine
#   make win     cross-compile build/EASYAMP.EXE (one exe for 98 SE through XP)
CC      ?= gcc
WINCC   ?= i686-w64-mingw32-gcc
CFLAGS  := -std=c99 -O2 -Wall -Wextra
# no SSE: the floor is a Pentium II / Celeron. The subsystem and OS version
# stamps are what let a real Windows 98 loader accept the file at all.
WINFLAGS := $(CFLAGS) -march=pentium2 -mtune=pentium3 -mno-sse -mfpmath=387 \
            -Wl,--major-subsystem-version,4 -Wl,--minor-subsystem-version,0 \
            -Wl,--major-os-version,4 -Wl,--minor-os-version,0
CORE    := src/gfx.c src/app.c src/ui.c src/fonts_gen.c src/palette_gen.c

build/easyamp-shot: $(CORE) src/main_shot.c src/*.h
	@mkdir -p build
	$(CC) $(CFLAGS) -o $@ $(CORE) src/main_shot.c -lm

shots: build/easyamp-shot
	@mkdir -p build/shots
	./build/easyamp-shot build/shots
	@python3 -c "import glob; from PIL import Image; [Image.open(f).save(f[:-4]+'.png') for f in glob.glob('build/shots/*.bmp')]"
	@rm -f build/shots/*.bmp

# re-tune the 256-colour palette to the current renders (commit the result)
palette: shots
	python3 tools/mkpalette.py

src/fonts_gen.c: tools/mkfont.py
	python3 tools/mkfont.py

clean:
	rm -rf build

.PHONY: shots clean palette

WINSRC := $(CORE) src/dsp.c src/engine_win32.c src/main_win32.c src/net_win32.c src/plex.c src/json.c src/source.c src/decoders.c

build/easyamp_res.o: src/easyamp.rc src/easyamp.ico
	@mkdir -p build
	i686-w64-mingw32-windres -I src src/easyamp.rc -o $@

build/EASYAMP.EXE: $(WINSRC) src/*.h build/easyamp_res.o build/libbearssl-win.a
	$(WINCC) $(WINFLAGS) -D_WIN32_WINNT=0x0400 -DWINVER=0x0400 -Ithird_party/bearssl/inc -mwindows -static -s -o $@ \
	    $(WINSRC) build/easyamp_res.o build/libbearssl-win.a -lwinmm -lcomdlg32 -lgdi32 -lshell32 -lws2_32
	@tools/check-imports.sh $@ || { rm -f $@; exit 1; }

win: build/EASYAMP.EXE

test: build/easyamp-shot
	$(CC) $(CFLAGS) -o build/test_dsp tests/test_dsp.c src/dsp.c src/app.c -lm && ./build/test_dsp
	$(CC) $(CFLAGS) -o build/test_json tests/test_json.c src/json.c && ./build/test_json
	$(CC) $(CFLAGS) -o build/test_eqio tests/test_eqio.c src/app.c -lm && ./build/test_eqio

.PHONY: win test

# ---- TLS (BearSSL, fetched and pinned; see tools/fetch-bearssl.sh) ----------------
BR      := third_party/bearssl
BRFLAGS := -O2 -march=pentium2 -mno-sse -mfpmath=387 -I$(BR)/inc -I$(BR)/src \
           -DBR_SSE2=0 -DBR_AES_X86NI=0 -DBR_RDRAND=0 -DBR_USE_WIN32_RAND=0

$(BR)/inc/bearssl.h:
	tools/fetch-bearssl.sh

build/libbearssl-win.a: $(BR)/inc/bearssl.h
	@mkdir -p build/br
	@for f in $$(find $(BR)/src -name '*.c'); do \
	    o=build/br/$$(echo $$f | sed 's|$(BR)/src/||; s|/|_|g; s|\.c$$|.o|'); \
	    [ $$o -nt $$f ] || $(WINCC) $(BRFLAGS) -c $$f -o $$o || exit 1; done
	@rm -f $@ && i686-w64-mingw32-ar rcs $@ build/br/*.o

build/TLSTEST.EXE: tests/tlstest.c src/net_win32.c src/net.h src/trust_anchors.h build/libbearssl-win.a
	$(WINCC) $(WINFLAGS) -D_WIN32_WINNT=0x0400 -DWINVER=0x0400 -I$(BR)/inc -mconsole -static -s -o $@ \
	    tests/tlstest.c src/net_win32.c build/libbearssl-win.a -lws2_32

anchors: $(BR)/inc/bearssl.h
	$(MAKE) -s -C $(BR) && { echo "/* GENERATED by brssl ta - see Makefile 'anchors' */"; \
	  $(BR)/build/brssl ta /etc/ssl/certs/DigiCert_Global_Root_G2.pem /etc/ssl/certs/DigiCert_Global_Root_CA.pem \
	  /etc/ssl/certs/ISRG_Root_X1.pem /etc/ssl/certs/USERTrust_RSA_Certification_Authority.pem \
	  /etc/ssl/certs/Amazon_Root_CA_1.pem; } > src/trust_anchors.h

.PHONY: anchors

build/PLEXTEST.EXE: tests/plextest.c src/plex.c src/json.c src/net_win32.c src/*.h build/libbearssl-win.a
	$(WINCC) $(WINFLAGS) -D_WIN32_WINNT=0x0400 -DWINVER=0x0400 -I$(BR)/inc -mconsole -static -s -o $@ \
	    tests/plextest.c src/plex.c src/json.c src/net_win32.c build/libbearssl-win.a -lws2_32

build/SRCTEST.EXE: tests/srctest.c src/source.c src/plex.c src/json.c src/net_win32.c src/*.h build/libbearssl-win.a
	$(WINCC) $(WINFLAGS) -D_WIN32_WINNT=0x0400 -DWINVER=0x0400 -I$(BR)/inc -mconsole -static -s -o $@ \
	    tests/srctest.c src/source.c src/plex.c src/json.c src/net_win32.c build/libbearssl-win.a -lws2_32
